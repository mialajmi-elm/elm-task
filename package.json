{
  "name": "elm-tasks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A small full-stack task tracker for a coding-agent demo.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node scripts/serve.js",
    "dev": "vite --host 127.0.0.1 --port 3000",
    "seed": "node scripts/seed.js",
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.js",
    "test:e2e": "npm run build && playwright test",
    "test:all": "npm test && npm run test:e2e && npm run typecheck",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.40",
    "@tanstack/react-start": "^1.168.59",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
